# 生產環境配置範例
# 複製此文件為 .env.prod 並修改相應的值

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# MinIO 配置 (生產環境)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sdl-files

# 生產環境建議使用更安全的設定：
# MINIO_ACCESS_KEY=your_secure_access_key
# MINIO_SECRET_KEY=your_secure_secret_key_minimum_8_characters

# 資料庫配置 (由 Docker Compose 提供)
# PG_HOST=postgres
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_NAME=sdls_fullstack_postgres1 