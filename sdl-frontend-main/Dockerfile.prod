# Stage 1: Build React app
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# 接收建構時環境變數（VITE_* 變數需在 build 階段注入）
ARG VITE_RAGFLOW_CHAT_ID
ENV VITE_RAGFLOW_CHAT_ID=$VITE_RAGFLOW_CHAT_ID

RUN npm run build

# Stage 2: Use serve to host static files
FROM node:22-alpine

WORKDIR /app

# 安裝 serve
RUN npm install -g serve

# 複製 build 後的檔案
COPY --from=builder /app/dist .

EXPOSE 5173

# 執行期以非 root 身分運作（serve 只讀靜態檔、監聽 5173，不需要 root）
USER node

CMD ["serve", "-s", ".", "-l", "5173"]
